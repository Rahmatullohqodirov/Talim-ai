# === Django asosiy ===
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=                     # python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=talim.uz,www.talim.uz
CSRF_TRUSTED_ORIGINS=https://talim.uz,https://www.talim.uz
CORS_ALLOWED_ORIGINS=https://talim.uz,https://www.talim.uz

# === Baza va cache (production: haqiqiy Postgres/Redis) ===
DATABASE_URL=postgres://user:password@localhost:5432/talim
REDIS_URL=redis://localhost:6379/1

# === Tashqi AI/servis kalitlari ===
# DIQQAT: bu qiymatlarni HECH QACHON git'ga yoki boshqa odamga zip qilib yubormang.
# Eski kalitlar (agar sizdan boshqa birov ko'rgan bo'lsa) darhol bekor qilinishi kerak.
YOUTUBE_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.1-fast
USD_TO_UZS_RATE=12700

# === To'lov provayderlari ===
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# === Monitoring (ixtiyoriy, lekin production uchun tavsiya etiladi) ===
SENTRY_DSN=

# === Frontend uchun ===
VITE_API_URL=https://api.talim.uz

# === AI Ustoz (Claude) ===
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Speaking uchun Whisper modeli: tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=small

# === Google / Facebook orqali kirish (faqat shu yerga yozish kifoya, frontend ID'larni serverdan oladi) ===
# Qanday olish: YANGILANISH.md -> "Google va Facebook orqali kirish"
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# To'lovdan keyin qaytish manzili
FRONTEND_URL=http://localhost:5173
